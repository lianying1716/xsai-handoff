  "facts": {
    "name": "星算会话交接",
    "capabilities": [
      "把当前会话整理成结构化交接文档",
      "存到本机固定目录，不污染项目仓库",
      "新会话自动认领最近一份，先匹配当前项目再退回全局",
      "写入前对凭据和个人信息做脱敏，并可自检"
    ],
    "requirements": [
      "Node.js 18 或更新版本"
    ],
    "limitations": [
